#!/bin/sh
# Root helper for the WaterForce 360 UI, called through pkexec.
# Only manages the display service and its settings drop-in; every argument is validated.
set -eu

UNIT=AorusWaterForce360-linux
DROPIN_DIR=/etc/systemd/system/$UNIT.service.d

fail() {
	echo "$1" >&2
	exit 2
}

# check_rpm <value> <min> <max> <what>
check_rpm() {
	echo "$1" | grep -Eqx '[1-9][0-9]{2,3}' && [ "$1" -ge "$2" ] && [ "$1" -le "$3" ] || fail "bad $4: $1"
}

# check_curve <temp:rpm,temp:rpm,temp:rpm,temp:rpm> <min> <max> <what>: temps 0..100 rising, RPM in range
check_curve() {
	echo "$1" | grep -Eqx '([0-9]{1,3}:[0-9]{3,4},){3}[0-9]{1,3}:[0-9]{3,4}' || fail "bad $4: $1"
	prev=-1
	for point in $(echo "$1" | tr ',' ' '); do
		temp=${point%%:*}
		rpm=${point#*:}
		[ "$temp" -le 100 ] && [ "$temp" -gt "$prev" ] || fail "bad $4: $1"
		check_rpm "$rpm" "$2" "$3" "$4"
		prev=$temp
	done
}

check_mode() {
	case "$1" in factory | fixed | curve) ;; *) fail "bad $2: $1" ;; esac
}

case "${1:-}" in
	start | stop | restart)
		systemctl "$1" "$UNIT"
		;;
	enable | disable)
		systemctl "$1" "$UNIT"
		;;
	apply)
		[ $# -eq 9 ] || fail "apply takes 8 arguments"
		sensor=$2 interval=$3
		fan_mode=$4 fan_rpm=$5 fan_curve=$6
		pump_mode=$7 pump_rpm=$8 pump_curve=$9
		echo "$sensor" | grep -Eqx '[A-Za-z0-9]{1,16}' || fail "bad sensor: $sensor"
		echo "$interval" | grep -Eqx '[1-9]|[1-5][0-9]|60' || fail "bad interval: $interval"
		check_mode "$fan_mode" "fan mode"
		check_rpm "$fan_rpm" 750 2750 "fan rpm"
		check_curve "$fan_curve" 750 2750 "fan curve"
		check_mode "$pump_mode" "pump mode"
		# the pump stays at 1600+ RPM, the lowest speed tested
		check_rpm "$pump_rpm" 1600 3200 "pump rpm"
		check_curve "$pump_curve" 1600 3200 "pump curve"
		mkdir -p "$DROPIN_DIR"
		printf '[Service]\nEnvironment=AWF_SENSOR=%s AWF_INTERVAL=%s\nEnvironment=AWF_FAN_MODE=%s AWF_FAN_RPM=%s AWF_FAN_CURVE=%s\nEnvironment=AWF_PUMP_MODE=%s AWF_PUMP_RPM=%s AWF_PUMP_CURVE=%s\n' \
			"$sensor" "$interval" "$fan_mode" "$fan_rpm" "$fan_curve" "$pump_mode" "$pump_rpm" "$pump_curve" >"$DROPIN_DIR/ui.conf"
		systemctl daemon-reload
		# restart only a running service, so "apply" never turns the display on by itself
		systemctl try-restart "$UNIT"
		;;
	*)
		echo "usage: $0 start|stop|restart|enable|disable" >&2
		echo "       $0 apply <sensor> <interval-sec> <fan-mode> <fan-rpm> <fan-curve> <pump-mode> <pump-rpm> <pump-curve>" >&2
		echo "       mode: factory|fixed|curve, curve: temp:rpm,temp:rpm,temp:rpm,temp:rpm" >&2
		exit 2
		;;
esac
